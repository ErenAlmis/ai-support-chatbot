# Copy to .env and fill in.
ANTHROPIC_API_KEY=

# Set to 1 to run without an API key (canned replies; good for UI demos).
DEMO_MODE=0

CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
BUSINESS_NAME=Harbor Dental Studio
KNOWLEDGE_FILE=knowledge/business.md

# Comma-separated list of sites allowed to embed the widget, e.g. https://client-site.com
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=20

# Secret for GET /api/leads (header: X-Admin-Token). Leave empty to disable the endpoint.
ADMIN_TOKEN=
